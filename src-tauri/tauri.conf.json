{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chameleon",
  "version": "0.8.1",
  "identifier": "com.chameleon.tool",
  "build": {
    "frontendDist": "www",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Chrome 会话隔离管理工具",
    "longDescription": "每个测试角色运行在独立的 Chrome 用户数据目录中，支持会话接力、快照与沙箱。纯本地离线。"
  }
}
